--=========================================
-- 7. KERNEL / CANCEL
--=========================================
local Begin = ReplicatedStorage:FindFirstChild("BeginAbility", true)
local Activate = ReplicatedStorage:FindFirstChild("AbilityActivated____", true)

local oldFireServer
if Activate then
    oldFireServer = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if method == "FireServer" and self == ReplicatedStorage.Remotes.GameServices.ToServer.AutoclickerDetected then
            return
        end

        if SETTINGS.KernelEnabled and not checkcaller() and self == Activate and method == "FireServer" then
            if currentTarget and currentTarget:FindFirstChild("HumanoidRootPart") then
                local tHRP = currentTarget.HumanoidRootPart
                local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myHRP then
                    local perfectAimCFrame = CFrame.lookAt(myHRP.Position, tHRP.Position)
                    for i, v in ipairs(args) do
                        if typeof(v) == "CFrame" then args[i] = perfectAimCFrame end
                        if typeof(v) == "Vector3" then args[i] = tHRP.Position end
                        if typeof(v) == "Instance" and v:IsA("Model") then args[i] = currentTarget end
                    end
                end
                if type(args[1]) == "number" and args[1] > 10^9 then
                    args[1] = args[1] - SETTINGS.Backtrack
                end
                return oldFireServer(self, unpack(args))
            end
        end

        return oldFireServer(self, ...)
    end)
end

RunService.PostSimulation:Connect(function()
    if not SETTINGS.KernelEnabled then return end
    local char = LocalPlayer.Character
    if char then
        if char:GetAttribute("Stunned") then char:SetAttribute("Stunned", false) end
        if char:GetAttribute("Busy") then char:SetAttribute("Busy", false) end
    end

    if tick() < nextBurstTime then return end

    if char and char:FindFirstChild("HumanoidRootPart") then
        local myPos = char.HumanoidRootPart.Position
        local bestDist = SETTINGS.DetectionRange * SETTINGS.DetectionRange
        local target = nil
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if p.Name == SETTINGS.WhitelistName then continue end
                local tHRP = p.Character.HumanoidRootPart
                if p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local distSq = (tHRP.Position - myPos).Magnitude
                    if distSq < bestDist then bestDist = distSq; target = p.Character end
                end
            end
        end
        currentTarget = target
    end

    if currentTarget and char then
        local tHRP = currentTarget:FindFirstChild("HumanoidRootPart")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and tHRP and (tHRP.Position - hrp.Position).Magnitude <= SETTINGS.CombatRange then
            if Begin then Begin:FireServer() end
            if Activate then
                for i = 1, SETTINGS.BurstSize do
                    Activate:FireServer(currentTarget)
                end
            end
            nextBurstTime = tick() + SETTINGS.BurstCooldown
        end
    end
end)

