-- Configurações e Estado das Funcionalidades
local SETTINGS = {
    KernelEnabled = false,
    ESPEnabled = false,
    BypassEnabled = true,
    SiphonSolverEnabled = false, -- Assistente automático do minigame Siphon Head
    DetectionRange = 1000,
    CombatRange = 900,
    BurstSize = 40,
    BurstCooldown = 0.05,
    Backtrack = 0,
}

-- Tabela de Whitelist (Nicks ignorados)
local WhitelistTable = {}
local espObjects = {}

local currentTarget = nil
local nextBurstTime = 0

-- Função para verificar se o player está na whitelist
local function isWhitelisted(player)
    if not player then return false end
    for _, name in ipairs(WhitelistTable) do
        if name ~= "" and player.Name:lower() == name:lower() then
            return true
        end
    end
    return false
end

-- Sistema de ESP Fino, Clássico e Branco
local function createESP(player)
    if player == LocalPlayer then return end
    
    local function setupCharacter(char)
        if char:FindFirstChild("Head") and not char.Head:FindFirstChild("EvzESP") then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "EvzESP"
            billboard.Size = UDim2.new(0, 120, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 2.5, 0)
            billboard.AlwaysOnTop = true
            billboard.Adornee = char.Head
            
            local label = Instance.new("TextLabel")
            label.Name = "Text"
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            label.TextStrokeTransparency = 0.5
            label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            label.Font = Enum.Font.SourceSans
            label.TextSize = 13
            label.Text = player.Name
            label.Parent = billboard
            
            billboard.Parent = char.Head
            espObjects[player] = billboard
        end
    end

    if player.Character then
        setupCharacter(player.Character)
    end
    player.CharacterAdded:Connect(setupCharacter)
end

local function removeESP(player)
    if espObjects[player] then
        espObjects[player]:Destroy()
        espObjects[player] = nil
    end
    if player.Character and player.Character:FindFirstChild("Head") then
        local esp = player.Character.Head:FindFirstChild("EvzESP")
        if esp then esp:Destroy() end
    end
end

local function updateESPState(state)
    for _, p in ipairs(Players:GetPlayers()) do
        if state then
            createESP(p)
        else
            removeESP(p)
        end
    end
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(char)
        if SETTINGS.ESPEnabled then
            task.wait(1)
            createESP(p)
        end
    end)
end)

Players.PlayerRemoving:Connect(removeESP)

-- Busca Dinâmica Segura contra Detecção/Ban
local function getSecureRemote(name)
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") and (v.Name == name or v.Name:lower():find(name:lower())) then
            return v
        end
    end
    return nil
end

local Begin = getSecureRemote("BeginAbility")
local Activate = getSecureRemote("AbilityActivated")
local oldFireServer

-- Bypass Avançado de Namecall e Bloqueio do AutoclickerDetected do TVL2
pcall(function()
    if Activate and hookmetamethod then
        oldFireServer = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            
            local selfName = tostring(self):lower()
            
            if SETTINGS.BypassEnabled and method == "FireServer" and (selfName:find("autoclicker") or selfName:find("detected") or selfName:find("ban") or selfName:find("exploit")) then 
                return 
            end
            
            if SETTINGS.KernelEnabled and not checkcaller() and self == Activate and method == "FireServer" then
                if currentTarget and currentTarget:FindFirstChild("HumanoidRootPart") then
                    local tHRP = currentTarget.HumanoidRootPart
                    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    
                    if myHRP then 
                        local perfectAimCFrame = CFrame.lookAt(myHRP.Position, tHRP.Position)
                        for i, v in ipairs(args) do 
                            if typeof(v) == "CFrame" then 
                                args[i] = perfectAimCFrame 
                            end
                            if typeof(v) == "Vector3" then 
                                args[i] = tHRP.Position 
                            end
                            if typeof(v) == "Instance" and v:IsA("Model") then
                                args[i] = currentTarget 
                            end
                        end
                    end
                end

                if type(args[1]) == "number" and args[1] > 10^9 then 
                    args[1] = args[1] - SETTINGS.Backtrack 
                end
                
                return oldFireServer(self, unpack(args))
            end 
            
            return oldFireServer(self, ...) 
        end)
    end
end)

-- Loop principal de Automação do Cancel e Detector do Minigame Siphon Head
RunService.PostSimulation:Connect(function()
    -- Lógica do Siphon Head Solver (Minigame da parte branca)[span_1](start_span)[span_1](end_span)
    if SETTINGS.SiphonSolverEnabled then
        pcall(function()
            for _, gui in ipairs({PlayersGui, CoreGui}) do
                for _, descendant in ipairs(gui:GetDescendants()) do
                    if descendant:IsA("GuiObject") and (descendant.Name:lower():find("siphon") or descendant.Name:lower():find("head") or descendant.Name:lower():find("circle") or descendant.Name:lower():find("ring")) then
                        -- Identifica elementos do minigame e valida se o ponteiro/marcador está na zona branca
                        local bgColor = descendant.BackgroundColor3
                        local imageColor = descendant.ImageColor3
                        local isWhite = (bgColor.R > 0.8 and bgColor.G > 0.8 and bgColor.B > 0.8) or (imageColor.R > 0.8 and imageColor.G > 0.8 and imageColor.B > 0.8)
                        
                        if isWhite and descendant.AbsoluteSize.X > 5 then
                            -- Simula o clique exato na parte branca do minigame[span_2](start_span)[span_2](end_span)
                            local pos = descendant.AbsolutePosition + (descendant.AbsoluteSize / 2)
                            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
                            task.wait(0.02)
                            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
                        end
                    end
                end
            end
        end)
    end

    if not SETTINGS.KernelEnabled then return end
    
    local char = LocalPlayer.Character
    if char then 
        if char:GetAttribute("Stunned") then 
            char:SetAttribute("Stunned", false) 
        end 
        if char:GetAttribute("Busy") then 
            char:SetAttribute("Busy", false) 
        end 
    end
    
    if tick() < nextBurstTime then return end

    if char and char:FindFirstChild("HumanoidRootPart") then
        local myPos = char.HumanoidRootPart.Position
        local bestDist = SETTINGS.DetectionRange * SETTINGS.DetectionRange
        local target = nil
        
        for _, p in ipairs(Players:GetPlayers()) do 
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if isWhitelisted(p) then continue end
                
                local tHRP = p.Character.HumanoidRootPart
                if p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local distSq = (tHRP.Position - myPos).Magnitude
                    if distSq < bestDist then 
                        bestDist = distSq
                        target = p.Character 
                    end 
                end 
            end
        end
        currentTarget = target
    end

    if currentTarget and char then 
        local tHRP = currentTarget:FindFirstChild("HumanoidRootPart")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        
        if hrp and tHRP and (tHRP.Position - hrp.Position).Magnitude <= SETTINGS.CombatRange then 
            if Begin then 
                pcall(function() Begin:FireServer() end)
            end 
            if Activate then
                pcall(function()
                    for i = 1, SETTINGS.BurstSize do
                        Activate:FireServer(currentTarget) 
                    end 
                end)
            end 
            nextBurstTime = tick() + SETTINGS.BurstCooldown 
        end 
    end
end)

