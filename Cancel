RunService.RenderStepped:Connect(function()
    if not SETTINGS.AimlockEnabled or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local myHRP = LocalPlayer.Character.HumanoidRootPart
    local best, bestDist = nil, SETTINGS.AimlockRange
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if p.Name == SETTINGS.WhitelistName then continue end
            local hrp = p.Character.HumanoidRootPart
            local d = (hrp.Position - myHRP.Position).Magnitude
            if d < bestDist then bestDist, best = d, hrp end
        end
    end
    if best then
        currentTarget = best.Parent
        workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, best.Position)
    else
        currentTarget = nil
    end
end)

--=========================================
-- 5. ESP
--=========================================
local function limparESP()
    for _, inst in ipairs(espInstances) do
        pcall(function() inst:Destroy() end)
    end
    espInstances = {}
end

local function atualizarESP()
    limparESP()
    if not SETTINGS.EspEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
            local bb = Instance.new("BillboardGui")
            bb.Name = "ReisESP"
            bb.Size = UDim2.new(0, 150, 0, 30)
            bb.StudsOffset = Vector3.new(0, 2.5, 0)
            bb.AlwaysOnTop = true
            bb.Parent = p.Character.Head

            local name = Instance.new("TextLabel")
            name.Size = UDim2.new(1, 0, 1, 0)
            name.BackgroundTransparency = 1
            name.Text = p.Name
            name.TextColor3 = Color3.fromRGB(180, 100, 255)
            name.TextSize = 14
            name.Font = Enum.Font.SourceSansBold
            name.Parent = bb

            table.insert(espInstances, bb)
        end
    end
end

