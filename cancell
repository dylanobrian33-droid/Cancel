    Title = "Adicionar Nick",
    Description = "Digite o nome exato do jogador para ignorar",
    Placeholder = "Nome do player...",
    Callback = function(v)
        inputName = v
    end
})

WhitelistTab:Button({
    Title = "Salvar na Whitelist",
    Callback = function()
        if inputName ~= "" then
            local exists = false
            for _, name in ipairs(WhitelistTable) do
                if name:lower() == inputName:lower() then
                    exists = true
                    break
                end
            end
            
            if not exists then
                table.insert(WhitelistTable, inputName)
                WindUI:Notify({
                    Title = "Whitelist",
                    Content = "Jogador " .. inputName .. " adicionado com sucesso!",
                    Duration = 3
                })
            end
        end
    end
})

WhitelistTab:Button({
    Title = "Limpar Whitelist",
    Callback = function()
        WhitelistTable = {}
        WindUI:Notify({
            Title = "Whitelist",
            Content = "A lista de whitelist foi limpa.",
            Duration = 3
        })
    end
})
